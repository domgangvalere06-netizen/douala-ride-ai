# Application
FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Database
DATABASE_URL=mysql+pymysql://douala_ride:password@localhost:3306/douala_ride

# Mistral AI - keep the real key only in your local .env / deployment secret store
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_TIMEOUT_SECONDS=30

# Maps
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# PawaPay Mobile Money - use sandbox first
PAWAPAY_API_URL=https://api.sandbox.pawapay.io
PAWAPAY_API_TOKEN=
PAWAPAY_PROVIDER=MTN_MOMO_CMR
PAWAPAY_CALLBACK_URL=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Runtime
LOG_LEVEL=INFO
